# MongoDB connection string (Atlas)
MONGODB_URI=
# Database name (defaults to "pathshala")
DB_NAME=pathshala
# Random secret, at least 32 characters, used to sign login tokens.
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=

# --- Telegram approval notifications (optional) ---
# Bot from @BotFather: the token and the bot's username (without @)
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
# Any long random string; Telegram sends it back so we know updates are genuine
TELEGRAM_WEBHOOK_SECRET=
# The site's public address, used for the "Open dashboard" button
APP_URL=
# Secret Vercel Cron sends to /api/cron/* (midnight summary, Sunday weekly report). Any long random string.
CRON_SECRET=
